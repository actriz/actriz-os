# ==========================================
# KEU OS / ACTRIZ OS - i3 Configuración Estándar
# ==========================================

set $mod Mod4
font pango:DejaVu Serif 8

# --- ATAJOS BÁSICOS ---
bindsym Control+Mod1+t exec --no-startup-id /opt/actriz/bin/terminal
bindsym $mod+Return exec --no-startup-id /opt/actriz/bin/terminal
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Z exec --no-startup-id flatpak run app.zen_browser.zen

# --- CONTROL DE VENTANAS (Estándar i3) ---
# Cerrar ventana (Q de Quit)
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# Pantalla Completa (F11 universal)
bindsym $mod+F11 fullscreen toggle

# Modo Flotante (Espacio)
bindsym $mod+space floating toggle

# Minimizar y Restaurar (Estándar i3 Scratchpad)
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show, floating disable

# --- MOVIMIENTO Y FOCO (Solo Flechas) ---
# Foco
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Mover ventana
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layouts
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# --- WORKSPACES (1 al 5) ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# --- TECLAS MULTIMEDIA ---
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# --- ESTÉTICA Y REGLAS ---
# Marco invisible de 3px para redimensionar con el ratón
default_border pixel 3
default_floating_border pixel 3

# Colores transparentes para el marco (RGBA: #RRGGBBAA)
client.focused          #00000000 #00000000 #00000000 #00000000 #00000000
client.focused_inactive #00000000 #00000000 #00000000 #00000000 #00000000
client.unfocused        #00000000 #00000000 #00000000 #00000000 #00000000
client.urgent           #00000000 #00000000 #00000000 #00000000 #00000000
client.placeholder      #00000000 #00000000 #00000000 #00000000 #00000000

# Aplicar marco invisible a todas las ventanas
for_window [class=".*"] border pixel 3, floating disable

# Gaps (Espaciado entre ventanas)
gaps inner 4
gaps outer 4
gaps top 30
gaps bottom 30

# Excepciones (Interfaces de Keu OS sin marco)
for_window [class="ActrizIsla"] floating enable, border none, sticky enable
for_window [class="ActrizIslaBajo"] floating enable, border none, sticky enable
for_window [class="KeuDock"] floating enable, border none, sticky enable
for_window [class="BoteReloj"] floating enable, border none, sticky enable, move position 807 2
for_window [class="BoteWifiBat"] floating enable, border none, sticky enable, move position 1012 2
for_window [class="Borde"] floating enable, border none, sticky enable, move position 0 0

# --- ARRANQUE ---
exec --no-startup-id dunst
# Wallpaper de Actriz (reejecuta en cada reload para nunca fallar)
exec_always --no-startup-id /opt/actriz/bin/set-wallpaper
exec_always --no-startup-id sh -c 'pkill -x picom 2>/dev/null; sleep 0.3; picom --config ~/.config/picom/picom.conf --daemon'
exec_always --no-startup-id sleep 1.5 && /opt/actriz/bin/start-islas.sh

# --- RECARGA Y SALIDA ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Salir de Keu OS?' -B 'Sí' 'i3-msg exit'"
bindsym $mod+a exec --no-startup-id /opt/actriz/bin/abc-app

# --- WORKSPACES EXTENDIDOS (6 al 10) ---
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
bindsym $mod+6  workspace number $ws6
bindsym $mod+7  workspace number $ws7
bindsym $mod+8  workspace number $ws8
bindsym $mod+9  workspace number $ws9
bindsym $mod+0  workspace number $ws10
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
